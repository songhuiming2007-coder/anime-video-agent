{
  "search": {
    "timeout_s": 20,
    "providers": [
      { "name": "exa_mcp" },
      { "name": "tavily", "api_key_env": "TAVILY_API_KEY" }
    ]
  },
  "fetch": {
    "timeout_s": 30,
    "max_bytes": 1000000,
    "max_chars": 30000
  },
  "crawl": {
    "timeout_s": 60,
    "max_chars": 30000
  },
  "browser": {
    "profile_dir": "data/browser-profile",
    "headed": true,
    "timeout_s": 60
  },
  "trusted_fake_ip_ranges": []
}
