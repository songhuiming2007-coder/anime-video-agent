{
  "search": {
    "timeout_s": 20,
    "providers": [
      { "name": "exa_mcp" },
      { "name": "tavily", "api_key_env": "TAVILY_API_KEY" }
    ]
  },
  "fetch": {
    "timeout_s": 30,
    "max_bytes": 1000000,
    "max_chars": 30000
  },
  "crawl": {
    "timeout_s": 60,
    "max_chars": 30000
  },
  "browser": {
    "profile_dir": "data/browser-profile-firefox",
    "headed": true,
    "timeout_s": 60,
    "cookies_for": ["youtube.com", "youtu.be", "bilibili.com", "x.com", "twitter.com"]
  },
  "chrome": {
    "command": "npx",
    "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect", "--redactNetworkHeaders"],
    "timeout_s": 45,
    "max_chars": 20000,
    "sensitive_hosts": [
      "accounts.google.com",
      "myaccount.google.com",
      "passport.bilibili.com",
      "pay.bilibili.com",
      "studio.youtube.com",
      "member.bilibili.com",
      "pay.weixin.qq.com",
      "alipay.com"
    ]
  },
  "trusted_fake_ip_ranges": []
}
