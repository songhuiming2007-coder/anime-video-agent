   {
    "function": {
     "description": "关键词联网检索（只读）。返回标题/URL/摘要三元组清单。静态获取失败会如实报错并提示升级链，严禁静默降级为水百科。",
     "name": "web_search",
     "parameters": {
      "additionalProperties": false,
      "properties": {
       "limit": {
        "description": "最多返回几条（默认 5，上限 10）",
        "type": "integer"
       },
       "query": {
        "description": "检索词",
        "type": "string"
       }
      },
      "required": [
       "query"
      ],
      "type": "object"
     }
    },
    "type": "function"
   },
   {
    "function": {
     "description": "抓取单个 URL 的网页净文（只读，升级链第一级静态获取）。限 http/https，拒连内网与二进制内容；失败如实报错并提示升级 crawl。",
     "name": "web_fetch",
     "parameters": {
      "additionalProperties": false,
      "properties": {
       "url": {
        "description": "http/https URL",
        "type": "string"
       }
      },
      "required": [
       "url"
      ],
      "type": "object"
     }
    },
    "type": "function"
   },
   {
    "function": {
     "description": "把素材候选追加到 data/library/incoming/candidates.json（人审用提案清单，追加式、同 URL 自动跳过）。只写提案，绝不抓取——fetch 永远由人逐条批准后 走 pipeline.acquire。每条必须含 title/url/type/source/why；why 要写清补哪个缺口、凭什么认为是它（skill: acquire-assets §一）。",
     "name": "acquire_propose",
     "parameters": {
      "additionalProperties": false,
      "properties": {
       "candidates": {
        "description": "一批候选（一次调用一张审批卡审整批）",
        "items": {
         "additionalProperties": false,
         "properties": {
          "expected_dur": {
           "description": "秒数，可空",
           "type": [
            "number",
            "null"
           ]
          },
          "source": {
           "description": "站点名 + 大致检索路径",
           "type": "string"
          },
          "title": {
           "type": "string"
          },
          "type": {
           "enum": [
            "live",
            "mv",
            "scan",
            "interview"
           ],
           "type": "string"
          },
          "url": {
           "description": "http/https 直链或视频页",
           "type": "string"
          },
          "why": {
           "description": "补哪个缺口 + 凭什么认为是它",
           "type": "string"
          }
         },
         "required": [
          "title",
          "url",
          "type",
          "source",
          "why"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "candidates"
      ],
      "type": "object"
     }
    },
    "type": "function"
   }
  ],
