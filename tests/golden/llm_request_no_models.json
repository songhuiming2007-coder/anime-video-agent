       "type": "string"
      }
     },
     "required": [
      "query"
     ],
     "type": "object"
    }
   },
   "type": "function"
  },
  {
   "function": {
    "description": "抓取单个 URL 的网页净文（只读，升级链第一级静态获取）。限 http/https，拒连内网与二进制内容；失败如实报错并提示升级 crawl。",
    "name": "web_fetch",
    "parameters": {
     "additionalProperties": false,
     "properties": {
      "url": {
       "description": "http/https URL",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    }
   },
   "type": "function"
  }
