{
 "frozen_tools": [
  {
   "function": {
    "description": "读取当期目录内文件或 data/library/ 下的笔记（只读）。读域写死：期目录内 + data/library/，且硬排除 03-audio/ 与 04-patch/（一律不出网）；越界或非文本类必拒。",
    "name": "read_artifact",
    "parameters": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "description": "相对路径，如 01-topic.md、02-script.draft.md、notes/春物.md",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    }
   },
   "type": "function"
  },
  {
   "function": {
    "description": "写入当期稿件文件。仅限 01-topic.md 与 02-script.draft.md；写 01-topic.md 必须 confirmed=true 且需人在 REPL 显式确认。",
    "name": "write_episode_file",
    "parameters": {
     "additionalProperties": false,
     "properties": {
      "confirmed": {
       "description": "写 01-topic.md 时必须为 true（人类已确认）",
       "type": "boolean"
      },
      "content": {
       "description": "完整文件内容",
       "type": "string"
      },
      "filename": {
       "description": "白名单内的文件名",
       "enum": [
        "01-topic.md",
        "02-script.draft.md"
       ],
       "type": "string"
      }
     },
     "required": [
      "filename",
      "content"
     ],
     "type": "object"
    }
   },
   "type": "function"
  },
  {
   "function": {
    "description": "列出可见期目录（排除 . 与 _ 前缀），返回期名列表与每期的阶段及阻塞标记（episodes_detail）。无参数。",
    "name": "list_episodes",
    "parameters": {
     "additionalProperties": false,
     "properties": {},
     "type": "object"
    }
   },
   "type": "function"
  },
  {
   "function": {
    "description": "读取某期的阶段状态卡（当前工序、停机点、advisories、推荐命令）。",
    "name": "read_status",
    "parameters": {
     "additionalProperties": false,
     "properties": {
      "episode": {
       "description": "期号或期目录路径；省略则用当期",
       "type": "string"
      }
     },
     "type": "object"
    }
   },
   "type": "function"
  },
  {
   "function": {
    "description": "在 data/library/ 只读笔记里做大小写不敏感的子串检索，返回命中片段。",
