      "query": {
       "description": "检索词",
       "type": "string"
      }
     },
     "required": [
      "query"
     ],
     "type": "object"
    }
   },
   "type": "function"
  },
  {
   "function": {
    "description": "关键词联网检索（只读）。返回标题/URL/摘要三元组清单。静态获取失败会如实报错并提示升级链，严禁静默降级为水百科。",
    "name": "web_search",
    "parameters": {
     "additionalProperties": false,
     "properties": {
      "limit": {
       "description": "最多返回几条（默认 5，上限 10）",
